{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "eval-p1p2-service-1-api",
    "Exporter": {
      "OtlpEndpoint": "http://localhost:4317"
    }
  },
  "Resilience": {
    "RetryCount": 3,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSeconds": 30,
    "TimeoutSeconds": 10
  },
  "AllowedHosts": "*"
}
