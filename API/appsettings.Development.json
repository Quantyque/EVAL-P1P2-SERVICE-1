{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Wolverine": "Warning",
        "WolverineFx": "Warning",
        "JasperFx": "Warning",
        "Marten": "Warning",
        "Npgsql": "Warning",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Resilience": {
    "RetryCount": 2,
    "CircuitBreakerFailures": 3,
    "CircuitBreakerDurationSeconds": 15,
    "TimeoutSeconds": 5
  },
  "OpenTelemetry": {
    "ServiceName": "eval-p1p2-service-1-api-dev",
    "Exporter": {
      "OtlpEndpoint": "http://127.0.0.1:4317"
    }
  },
  "ConnectionStrings": {
    "RabbitMq": "amqp://guest:guest@localhost:5672",
    "Marten": "Host=localhost;Port=5432;Database=eval_p1p2_service1_saga;Username=postgres;Password=postgres"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5301",
        "Protocols": "Http1"
      }
    }
  }
}
